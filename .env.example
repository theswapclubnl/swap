# Copy this file to .env for local development. Never commit the real .env.
# On Vercel, add the same names under Project -> Settings -> Environment Variables.

# Gmail account that sends AND receives the contact form emails
GMAIL_USERNAME=your_username
# 16-character Google "App password" (NOT your normal Gmail password)
GMAIL_APP_PASSWORD=your_password

CONTACT_TO_EMAIL = your_email

# Google Analytics 4 Measurement ID, e.g. G-XXXXXXXXXX (leave empty to disable)
GA_MEASUREMENT_ID= G-XXXXXXXXXX

# Long random string, used to sign flash messages.  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY= secret_key
